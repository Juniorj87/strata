{
  "name": "strata",
  "private": true,
  "version": "0.1.0",
  "description": "Trading strategies as contracts on Asentum",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "chain:check": "node --experimental-strip-types scripts/check-chain.ts",
    "chain:verify": "node --experimental-strip-types scripts/check-verify.ts",
    "deploy:hub": "node --experimental-strip-types scripts/deploy.ts --template strata-hub",
    "deploy:momentum-signal": "node --experimental-strip-types scripts/deploy.ts --template momentum-signal",
    "deploy:momentum-trader": "node --experimental-strip-types scripts/deploy.ts --template momentum-trader",
    "deploy:twap": "node --experimental-strip-types scripts/deploy.ts --template twap",
    "deploy:grid": "node --experimental-strip-types scripts/deploy.ts --template grid",
    "deploy:dca": "node --experimental-strip-types scripts/deploy.ts --template dca"
  },
  "dependencies": {
    "@asentum/connect": "^0.1.9",
    "@asentum/sdk": "^0.2.0",
    "@noble/hashes": "^2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
